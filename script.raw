--[[
    SWILL MM2 | ESP + HARD AIM + GUN TP
    Жёсткий аим на голове мёрдерера (без плаванья)
    Чёрный GUI, белая обводка
    Создан: 26.09.2025
    TG: @swill_way
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LP = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local roles

-- ПЕРЕМЕННЫЕ
local Murderer = nil
local MurdererName = ""
local SheriffName = ""
local HeroName = ""
local MyRole = "Неизвестно"

-- HARD AIM (жёсткий, всегда на голове)
local AimEnabled = false
local TargetPart = "Head"

-- GUN TP
local GunCollected = false
local SheriffWasAlive = true
local AutoGunEnabled = true
local tpLock = false
local gunChecked = false

-- ESP
local ESPEnabled = true

-- ==================== ФУНКЦИИ ====================

function IsAlive(Player)
    if not Player then return false end
    for i, v in pairs(roles) do
        if Player.Name == i then
            if not v.Killed and not v.Dead then return true end
        end
    end
    return false
end

local function GetPlayerData()
    local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not getData then return nil end
    local success, roles = pcall(function() return getData:InvokeServer() end)
    if not success or not roles then return nil end
    return roles
end

local function FindMurderer()
    local rolesData = GetPlayerData()
    if not rolesData then return nil end
    for playerName, data in pairs(rolesData) do
        if data.Role == "Murderer" and not data.Killed and not data.Dead then
            local murderer = Players:FindFirstChild(playerName)
            if murderer and murderer.Character then return murderer end
        end
    end
    return nil
end

local function GetMurdererTargetPart()
    local murderer = FindMurderer()
    if not murderer or not murderer.Character then return nil end
    
    local part = murderer.Character:FindFirstChild(TargetPart)
    if part then return part end
    
    return murderer.Character:FindFirstChild("HumanoidRootPart")
end

-- ЖЁСТКИЙ АИМ (камера всегда на голове, без плаванья)
local function AimAtMurderer()
    if not AimEnabled then return end
    
    local targetPart = GetMurdererTargetPart()
    if not targetPart then return end
    
    local humanoid = targetPart.Parent:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Принудительно направляем камеру на голову
    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
end

function FindDroppedGun()
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "DroppedGun" or v.Name == "GunDrop" then
            if v:IsA("BasePart") then
                local isInPlayer = false
                local current = v.Parent
                while current do
                    if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
                        isInPlayer = true
                        break
                    end
                    current = current.Parent
                end
                if not isInPlayer then return v.Position end
            end
        end
        if v.Name == "Handle" and v:IsA("BasePart") then
            local parent = v.Parent
            if parent and (parent.Name == "DroppedGun" or parent.Name == "GunDrop") then
                local isInPlayer = false
                local current = parent.Parent
                while current do
                    if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
                        isInPlayer = true
                        break
                    end
                    current = current.Parent
                end
                if not isInPlayer then return v.Position end
            end
        end
    end
    return nil
end

function HasGun()
    if not LP.Character then return false end
    for _, v in pairs(LP.Character:GetChildren()) do
        if v:IsA("Tool") and (v.Name:lower():find("gun") or v.Name:lower():find("pistol") or v.Name:lower():find("revolver")) then
            return true
        end
    end
    if LP.Backpack then
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.Name:lower():find("gun") or v.Name:lower():find("pistol") or v.Name:lower():find("revolver")) then
                return true
            end
        end
    end
    return false
end

function QuickTPToGun()
    local gunPos = FindDroppedGun()
    if not gunPos then
        StatusLabel.Text = "Нет пистолета"
        return false
    end
    
    if not LP.Character then return false end
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local oldPos = hrp.Position
    
    pcall(function()
        hrp.CFrame = CFrame.new(gunPos + Vector3.new(0, 3, 0))
    end)
    StatusLabel.Text = "ТП к пистолету"
    
    task.wait(0.5)
    
    if HasGun() then
        GunCollected = true
        StatusLabel.Text = "Подобрал"
    end
    
    pcall(function()
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            LP.Character.HumanoidRootPart.CFrame = CFrame.new(oldPos)
        end
    end)
    StatusLabel.Text = "Обратно"
    
    return true
end

