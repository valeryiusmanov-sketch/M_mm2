-- ═══════════════════════════════════════════════
-- SWILL - MM2: Aim (ZERO DELAY) + TP Gun + ESP
-- ═══════════════════════════════════════════════

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ═══════════════════════════════════════════════
-- НАСТРОЙКИ
-- ═══════════════════════════════════════════════
local Settings = {
    AimEnabled = false,
    TargetPart = "Head",
    ESPEnabled = true,
}

-- ═══════════════════════════════════════════════
-- ПЕРЕМЕННЫЕ
-- ═══════════════════════════════════════════════
local roles = {}
local MyRole = "Неизвестно"
local MurdererName = ""
local SheriffName = ""
local savedPosition = nil
local espHighlights = {}

-- Цель для аима (глобальная)
local aimTarget = nil

-- ═══════════════════════════════════════════════
-- ФУНКЦИИ
-- ═══════════════════════════════════════════════

function IsAlive(Player)
    if not Player then return false end
    for i, v in pairs(roles) do
        if Player.Name == i then
            if not v.Killed and not v.Dead then
                return true
            else
                return false
            end
        end
    end
    return false
end

function GetHeadPosition(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head.Position
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position + Vector3.new(0, 2.5, 0) end
    return nil
end

-- ПОИСК УПАВШЕГО ПИСТОЛЕТА
function FindDroppedGun()
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "DroppedGun" or v.Name == "GunDrop" or v.Name == "Gun" then
            local parent = v.Parent
            if parent and parent ~= LocalPlayer.Character then
                local isInPlayer = false
                local current = parent
                while current do
                    if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
                        isInPlayer = true
                        break
                    end
                    current = current.Parent
                end
                if not isInPlayer then
                    if v:IsA("BasePart") then
                        return v.Position
                    elseif v:IsA("Model") then
                        local part = v:FindFirstChild("Handle") or v:FindFirstChildWhichIsA("BasePart")
                        if part then return part.Position end
                    end
                end
            end
        end
    end
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "Handle" and v:IsA("BasePart") then
            local parent = v.Parent
            if parent and (parent.Name == "DroppedGun" or parent.Name == "GunDrop" or parent.Name == "Gun") then
                local isInPlayer = false
                local current = parent.Parent
                while current do
                    if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
                        isInPlayer = true
                        break
                    end
                    current = current.Parent
                end
                if not isInPlayer then
                    return v.Position
                end
            end
        end
    end
    
    return nil
end

function HasGun()
    if not LocalPlayer.Character then return false end
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Tool") and (v.Name:lower():find("gun") or v.Name:lower():find("pistol") or v.Name:lower():find("revolver") or v.Name == "Gun") then
            return true
        end
    end
    if LocalPlayer.Backpack then
        for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.Name:lower():find("gun") or v.Name:lower():find("pistol") or v.Name:lower():find("revolver") or v.Name == "Gun") then
                return true
            end
        end
    end
    return false
end

function TeleportToPosition(pos)
    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
end

function SmoothTeleport(targetPos)
    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local goal = {CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))}
    local tween = TweenService:Create(hrp, tweenInfo, goal)
    tween:Play()
    tween.Completed:Wait()
end

-- ═══════════════════════════════════════════════
-- ТП К ПИСТОЛЕТУ С ВОЗВРАТОМ
-- ═══════════════════════════════════════════════
local function QuickTPToGun()
    local gunPos = FindDroppedGun()
    if not gunPos then
        return
    end
    
    if not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    savedPosition = hrp.Position
    
    pcall(function()
        SmoothTeleport(gunPos)
    end)
    
    task.wait(1.2)
    
    if not HasGun() then
        local gunPos2 = FindDroppedGun()
        if gunPos2 and not HasGun() then
            pcall(function()
                TeleportToPosition(gunPos2)
            end)
            task.wait(0.8)
        end
    end
    
    if savedPosition then
        task.wait(0.3)
        pcall(function()
            SmoothTeleport(savedPosition)
        end)
        savedPosition = nil
    end
end

-- ═══════════════════════════════════════════════
-- ZERO DELAY AIM (МГНОВЕННЫЙ, КАЖДЫЙ ТИК)
-- ═══════════════════════════════════════════════
local function updateAim()
    if not Settings.AimEnabled then 
        aimTarget = nil
        return 
    end
    
    -- Только для Шерифа и Героя
    if MyRole ~= "Sheriff" and MyRole ~= "Hero" then
        aimTarget = nil
        return
    end
    
    local murderer = Players:FindFirstChild(MurdererName)
    if not murderer or not murderer.Character then
        aimTarget = nil
        return
    end
    
    if not IsAlive(murderer) then
        aimTarget = nil
        return
    end
    
    local headPos = GetHeadPosition(murderer.Character)
    if headPos then
        aimTarget = headPos
        -- Мгновенная установка камеры на голову (без задержки)
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.new(camPos, headPos)
    else
        aimTarget = nil
    end
end

-- ═══════════════════════════════════════════════
-- ESP (ПО РОЛЯМ)
-- ═══════════════════════════════════════════════
local function updateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local highlight = espHighlights[plr]
            
            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "RoleESP"
                highlight.FillTransparency = 0.4
                highlight.OutlineTransparency = 0
                highlight.Parent = game.CoreGui
                espHighlights[plr] = highlight
            end
            
            if Settings.ESPEnabled and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                highlight.Adornee = plr.Character
                highlight.Enabled = true
                
                local isMurderer = false
                local isSheriff = false
                
                for name, data in pairs(roles) do
                    if name == plr.Name then
                        if data.Role == "Murderer" then
                            isMurderer = true
                        elseif data.Role == "Sheriff" then
                            isSheriff = true
                        end
                        break
                    end
                end
                
                if isMurderer and IsAlive(plr) then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.FillTransparency = 0.3
                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                elseif isSheriff and IsAlive(plr) then
                    highlight.FillColor = Color3.fromRGB(0, 0, 255)
                    highlight.FillTransparency = 0.3
                    highlight.OutlineColor = Color3.fromRGB(50, 100, 255)
                else
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.85
                    highlight.OutlineColor = Color3.fromRGB(200, 200, 200)
                end
            else
                highlight.Adornee = nil
                highlight.Enabled = false
            end
        end
    end
end

Players.PlayerRemoving:Connect(function(plr)
    if espHighlights[plr] then
        espHighlights[plr]:Destroy()
        espHighlights[plr] = nil
    end
end)

-- ═══════════════════════════════════════════════
-- GUI
-- ═══════════════════════════════════════════════
local function CreateGUI()
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    if PlayerGui:FindFirstChild("SWILL_HUB") then
        PlayerGui:FindFirstChild("SWILL_HUB"):Destroy()
    end
    
    local gui = Instance.new("ScreenGui")
    gui.Name = "SWILL_HUB"
    gui.ResetOnSpawn = false
    gui.Parent = PlayerGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 170, 0, 175)
    MainFrame.Position = UDim2.new(0.02, 0, 0.5, -87)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 30)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.BorderSizePixel = 2
    MainFrame.BorderColor3 = Color3.fromRGB(0, 255, 200)
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = gui
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

    -- Заголовок
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, 0, 0, 25)
    TitleLabel.Position = UDim2.new(0, 0, 0, 5)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "⚡ SWILL"
    TitleLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
    TitleLabel.TextScaled = true
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Parent = MainFrame

    -- Инфо
    local InfoLabel = Instance.new("TextLabel")
    InfoLabel.Size = UDim2.new(1, 0, 0, 20)
    InfoLabel.Position = UDim2.new(0, 0, 0, 30)
    InfoLabel.BackgroundTransparency = 1
    InfoLabel.Text = "🔴 Убийца | 🔵 Шериф"
    InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    InfoLabel.TextScaled = true
    InfoLabel.Font = Enum.Font.Gotham
    InfoLabel.Parent = MainFrame

    -- Кнопка закрытия
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 25, 0, 25)
    closeBtn.Position = UDim2.new(1, -28, 0, 2)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    closeBtn.TextSize = 16
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = MainFrame
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    -- Кнопка Aim (ZERO DELAY)
    local AimBtn = Instance.new("TextButton")
    AimBtn.Size = UDim2.new(0.9, 0, 0, 28)
    AimBtn.Position = UDim2.new(0.05, 0, 0, 55)
    AimBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
    AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    AimBtn.Text = "🎯 Aim OFF"
    AimBtn.TextScaled = true
    AimBtn.Font = Enum.Font.GothamBold
    AimBtn.AutoButtonColor = false
    AimBtn.Parent = MainFrame
    Instance.new("UICorner", AimBtn).CornerRadius = UDim.new(0, 8)

    -- Кнопка TP Gun
    local GunTpBtn = Instance.new("TextButton")
    GunTpBtn.Size = UDim2.new(0.9, 0, 0, 28)
    GunTpBtn.Position = UDim2.new(0.05, 0, 0, 87)
    GunTpBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
    GunTpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    GunTpBtn.Text = "🔫 TP Gun"
    GunTpBtn.TextScaled = true
    GunTpBtn.Font = Enum.Font.GothamBold
    GunTpBtn.AutoButtonColor = false
    GunTpBtn.Parent = MainFrame
    Instance.new("UICorner", GunTpBtn).CornerRadius = UDim.new(0, 8)

    -- Кнопка ESP
    local EspBtn = Instance.new("TextButton")
    EspBtn.Size = UDim2.new(0.9, 0, 0, 28)
    EspBtn.Position = UDim2.new(0.05, 0, 0, 119)
    EspBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
    EspBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    EspBtn.Text = "👁 ESP ON"
    EspBtn.TextScaled = true
    EspBtn.Font = Enum.Font.GothamBold
    EspBtn.AutoButtonColor = false
    EspBtn.Parent = MainFrame
    Instance.new("UICorner", EspBtn).CornerRadius = UDim.new(0, 8)

    -- ЛОГИКА
    local aimState = false
    local espState = true

    AimBtn.MouseButton1Click:Connect(function()
        aimState = not aimState
        Settings.AimEnabled = aimState
        if aimState then
            AimBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            AimBtn.Text = "🎯 Aim ON"
        else
            AimBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
            AimBtn.Text = "🎯 Aim OFF"
            aimTarget = nil
        end
    end)

    GunTpBtn.MouseButton1Click:Connect(function()
        QuickTPToGun()
    end)

    EspBtn.MouseButton1Click:Connect(function()
        espState = not espState
        Settings.ESPEnabled = espState
        if espState then
            EspBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            EspBtn.Text = "👁 ESP ON"
        else
            EspBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
            EspBtn.Text = "👁 ESP OFF"
            for _, hl in pairs(espHighlights) do
                if hl then hl.Enabled = false end
            end
        end
    end)
    
    return gui
end

-- ═══════════════════════════════════════════════
-- ОСНОВНОЙ ЦИКЛ (ОБНОВЛЕНИЕ РОЛЕЙ + ESP)
-- ═══════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if getData then
        pcall(function()
            roles = getData:InvokeServer()
            MyRole = "Неизвестно"
            MurdererName = ""
            SheriffName = ""
            
            for i, v in pairs(roles) do
                if v.Role == "Murderer" then
                    MurdererName = i
                elseif v.Role == "Sheriff" then
                    SheriffName = i
                end
                
                if i == LocalPlayer.Name then
                    MyRole = v.Role or "Неизвестно"
                end
            end
        end)
    end
    
    -- Обновляем ESP
    updateESP()
end)

-- ═══════════════════════════════════════════════
-- ОТДЕЛЬНЫЙ ЦИКЛ ДЛЯ АИМА (МАКСИМАЛЬНО БЫСТРЫЙ)
-- ═══════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    updateAim()
end)

