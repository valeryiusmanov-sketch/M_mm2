        StatusLabel.Text = "Авто OFF"
    end
end)

-- ==================== ESP ХАЙЛАЙТЫ ====================

function CreateHighlight()
    for i, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character then
            if not v.Character:FindFirstChild("SWILL_HL") then
                local hl = Instance.new("Highlight")
                hl.Name = "SWILL_HL"
                hl.Parent = v.Character
            end
        end
    end
end

function UpdateHighlights()
    for _, v in pairs(Players:GetChildren()) do
        if v ~= LP and v.Character then
            local hl = v.Character:FindFirstChild("SWILL_HL")
            if hl then
                hl.Enabled = ESPEnabled
                if v.Name == MurdererName and IsAlive(v) then
                    hl.FillColor = Color3.fromRGB(225, 0, 0)
                elseif v.Name == SheriffName and IsAlive(v) then
                    hl.FillColor = Color3.fromRGB(0, 0, 225)
                elseif v.Name == HeroName and IsAlive(v) then
                    hl.FillColor = Color3.fromRGB(255, 250, 0)
                else
                    hl.FillColor = Color3.fromRGB(0, 225, 0)
                end
            end
        end
    end
end

-- ==================== АВТО ТП ====================

local function DoAutoTP()
    if tpLock then return end
    tpLock = true
    
    local gunPos = FindDroppedGun()
    if not gunPos then
        StatusLabel.Text = "Жду пистолет..."
        tpLock = false
        return
    end
    
    if not LP.Character then
        tpLock = false
        return
    end
    
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        tpLock = false
        return
    end
    
    local oldPos = hrp.Position
    
    StatusLabel.Text = "ТП к пистолету"
    
    pcall(function()
        hrp.CFrame = CFrame.new(gunPos + Vector3.new(0, 3, 0))
    end)
    
    task.wait(0.5)
    
    if HasGun() then
        GunCollected = true
        StatusLabel.Text = "Подобрал"
    end
    
    pcall(function()
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            LP.Character.HumanoidRootPart.CFrame = CFrame.new(oldPos)
        end
    end)
    StatusLabel.Text = "Обратно"
    
    task.wait(0.3)
    tpLock = false
end

function AutoGunTPCheck()
    if not AutoGunEnabled then
        gunChecked = false
        return
    end
    if MyRole ~= "Hero" and MyRole ~= "Герой" then return end
    if not LP.Character then return end
    if not IsAlive(LP) then
        gunChecked = false
        tpLock = false
        return
    end
    if GunCollected then return end
    if HasGun() then
        GunCollected = true
        return
    end
    
    local sheriffPlayer = nil
    if SheriffName ~= "" then
        sheriffPlayer = Players:FindFirstChild(SheriffName)
    end
    
    if sheriffPlayer and IsAlive(sheriffPlayer) then
        SheriffWasAlive = true
        gunChecked = false
        tpLock = false
        GunCollected = false
        return
    end
    
    if not sheriffPlayer then return end
    
    if SheriffWasAlive then
        SheriffWasAlive = false
        StatusLabel.Text = "Шериф убит"
        
        local waited = 0
        while waited < 3 do
            if FindDroppedGun() then break end
            task.wait(0.3)
            waited = waited + 0.3
        end
        
        if FindDroppedGun() then
            DoAutoTP()
        else
            StatusLabel.Text = "Нет пистолета"
        end
    end
end

-- ==================== ОСНОВНОЙ ЦИКЛ ====================

RunService.RenderStepped:Connect(function()
    local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if getData then
        pcall(function()
            roles = getData:InvokeServer()
            
            MurdererName = ""
            SheriffName = ""
            HeroName = ""
            
            for i, v in pairs(roles) do
                if v.Role == "Murderer" then
                    MurdererName = i
                    Murderer = Players:FindFirstChild(i)
                elseif v.Role == "Sheriff" then
                    SheriffName = i
                elseif v.Role == "Hero" then
                    HeroName = i
                end
                
                if i == LP.Name then
                    MyRole = v.Role or "Неизвестно"
                end
            end
        end)
    end
    
    RoleLabel.Text = MyRole
    
    CreateHighlight()
    UpdateHighlights()
    
    -- Жёсткий аим
    if AimEnabled then
        if MyRole == "Sheriff" or MyRole == "Шериф" or MyRole == "Hero" or MyRole == "Герой" then
            AimAtMurderer()
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            AutoGunTPCheck()
        end)
    end
end)

print("SWILL v6 + Hard Aim loaded")
