        AimBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        AimBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        AimStroke.Color = Color3.fromRGB(0, 0, 0)
        StatusLabel.Text = "Аим ON"
    else
        AimBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        AimStroke.Color = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Аим OFF"
    end
end)

